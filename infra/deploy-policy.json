{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3SAMManaged",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:CreateBucket",
        "s3:PutBucketPolicy",
        "s3:PutBucketVersioning",
        "s3:PutBucketTagging",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketVersioning"
      ],
      "Resource": ["arn:aws:s3:::aws-sam-cli-managed-*", "arn:aws:s3:::aws-sam-cli-managed-*/*"]
    },
    {
      "Sid": "S3RelayOutbox",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:PutBucketTagging",
        "s3:GetBucketTagging",
        "s3:PutLifecycleConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketNotification",
        "s3:GetBucketNotification",
        "s3:GetBucketPolicy",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketVersioning"
      ],
      "Resource": ["arn:aws:s3:::lexflow-relay-outbox-*", "arn:aws:s3:::lexflow-relay-outbox-*/*"]
    },
    {
      "Sid": "CloudFormationStackScoped",
      "Effect": "Allow",
      "Action": ["cloudformation:*"],
      "Resource": [
        "arn:aws:cloudformation:sa-east-1:394559824800:stack/lexflow-api-*/*",
        "arn:aws:cloudformation:sa-east-1:aws:transform/Serverless-2016-10-31"
      ]
    },
    {
      "Sid": "CloudFormationCommon",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStacks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Lambda",
      "Effect": "Allow",
      "Action": ["lambda:*"],
      "Resource": [
        "arn:aws:lambda:sa-east-1:394559824800:function:lexflow-api-*",
        "arn:aws:lambda:sa-east-1:394559824800:function:lexflow-relay-*",
        "arn:aws:lambda:sa-east-1:394559824800:function:lexflow-stream-*"
      ]
    },
    {
      "Sid": "LambdaLayersGlobal",
      "Effect": "Allow",
      "Action": ["lambda:GetLayerVersion", "lambda:PublishLayerVersion"],
      "Resource": "*"
    },
    {
      "Sid": "APIGateway",
      "Effect": "Allow",
      "Action": ["apigateway:*"],
      "Resource": "arn:aws:apigateway:sa-east-1::*"
    },
    {
      "Sid": "IAMForStackRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:PassRole",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::394559824800:role/lexflow-api-*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DescribeLogGroups",
        "logs:DeleteLogGroup",
        "logs:TagResource"
      ],
      "Resource": [
        "arn:aws:logs:sa-east-1:394559824800:log-group:/aws/lambda/lexflow-api-*",
        "arn:aws:logs:sa-east-1:394559824800:log-group:/aws/lambda/lexflow-relay-*",
        "arn:aws:logs:sa-east-1:394559824800:log-group:/aws/lambda/lexflow-stream-*"
      ]
    },
    {
      "Sid": "EC2VPCRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:DescribeNetworkInterfaces"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SSMRead",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:sa-east-1:394559824800:parameter/lexflow/*"
    },
    {
      "Sid": "S3Frontend",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::lexflow-frontend-mrhewbuc",
        "arn:aws:s3:::lexflow-frontend-mrhewbuc/*",
        "arn:aws:s3:::lexflow-mobile-frontend-mrhewbuc",
        "arn:aws:s3:::lexflow-mobile-frontend-mrhewbuc/*"
      ]
    },
    {
      "Sid": "CloudFrontInvalidation",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation"],
      "Resource": "arn:aws:cloudfront::394559824800:distribution/*"
    }
  ]
}
