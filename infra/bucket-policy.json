{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudFrontServicePrincipalReadOnly",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::lexflow-frontend-mrhewbuc/*",
      "Condition": {
        "StringEquals": { "AWS:SourceArn": "DISTRIBUTION_ARN_PLACEHOLDER" }
      }
    }
  ]
}
