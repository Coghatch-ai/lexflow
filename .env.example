# Database (RDS — prod uses SSM; this file is for local dev only)
# lexflow has its own database + role on the shared mrhewbuc-rds instance.
DB_HOST=mrhewbuc-rds.ctaccs4ugjxb.sa-east-1.rds.amazonaws.com
DB_NAME=lexflow
DB_USER=lexflow_user
DB_PASSWORD=your-password

# Or use a single connection string
# DATABASE_URL=postgresql://user:password@host/lexflow

# Frontend — Vite-visible (bundled into the client)
# Dev: http://localhost:3001/api/trpc (Express mount path)
# Prod: https://<id>.execute-api.sa-east-1.amazonaws.com/prod (API Gateway URL)
VITE_API_URL=http://localhost:3001/api/trpc
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend Clerk — prod reads these from SSM at /lexflow/api/${env}/*
# CLERK_JWT_KEY is the PEM public key from Clerk Dashboard → API Keys
# CLERK_WEBHOOK_SECRET is the signing secret from Clerk Dashboard → Webhooks
# CLERK_SECRET_KEY is the backend API key from Clerk Dashboard
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
