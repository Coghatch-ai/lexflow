{
  "name": "lexflow",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch api/dev-server.ts",
    "dev:app": "vite",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.api.json && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm check && pnpm lint && pnpm test",
    "prepare": "husky || true",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-csv": "tsx scripts/seed-from-csv.ts",
    "db:create-user": "tsx scripts/create-user.ts",
    "db:make-admin": "tsx scripts/make-admin.ts",
    "db:verify": "tsx scripts/verify-export.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@clerk/backend": "^2.29.6",
    "@clerk/clerk-react": "^5.60.0",
    "@clerk/localizations": "^3.30.1",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "lucide-react": "^0.453.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "superjson": "^1.13.3",
    "svix": "^1.42.0",
    "wouter": "^3.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/aws-lambda": "^8.10.160",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "csv-parse": "^6.2.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "esbuild"
    ]
  }
}
