# api/.env.example — copy to api/.env for local development.
# AI grading/explanation + GitHub issue ops go through the API → lexflow-relay
# (api/lib/relay.ts invokes lexflow-relay-${env} over IAM). The backend makes no
# direct outbound calls; the relay holds the Gemini key / GitHub PAT / SMTP creds.
# Local dev that exercises those needs AWS creds in the environment.

# Database credentials (prod reads from SSM at /lexflow/api/${env}/*)
DB_HOST=mrhewbuc-rds.ctaccs4ugjxb.sa-east-1.rds.amazonaws.com
DB_NAME=lexflow
DB_USER=lexflow_user
DB_PASSWORD=
# Or a single connection string:
# DATABASE_URL=postgresql://user:password@host/lexflow
