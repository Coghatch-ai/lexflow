# api/.env.example — copy to api/.env and fill AI_API_KEY for LOCAL AI grading.
# The deployed Lambda has no NAT, so this path is local-dev only; production AI
# grading uses the central relay (mrhewbuc-issues, task=complete).
#
# Provider options:
#   AI_PROVIDER=gemini  AI_MODEL=gemini-2.0-flash            (Google AI Studio key)
#   AI_PROVIDER=openai  AI_MODEL=gpt-4o-mini                 (OpenAI key)
#   AI_PROVIDER=openai  AI_MODEL=llama-3.3-70b-versatile  AI_BASE_URL=https://api.groq.com/openai/v1  (Groq key)

AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=
# AI_BASE_URL=
